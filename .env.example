# B.AI API key (https://docs.b.ai/) for the concierge models:
# hy3, mimo-v2.5, glm-5.3-flash, qwen3.8-flash
# Without this key the app still works — the assistant answers from the built-in offline engine.
BAI_API_KEY=

# Optional: Supabase persistence (auth OTP, listings, proposals, circles).
# Without these the app runs on local sample data stored in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
